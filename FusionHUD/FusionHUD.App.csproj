<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>

		<TargetFramework>net10.0-windows</TargetFramework>

		<Nullable>enable</Nullable>

		<ImplicitUsings>enable</ImplicitUsings>

		<UseWPF>true</UseWPF>

		<PlatformTarget>x64</PlatformTarget>

		<Platforms>AnyCPU;x64</Platforms>

		<AssemblyName>FusionHUD.App</AssemblyName>

		<RootNamespace>FusionHUD.App</RootNamespace>
	  <UserSecretsId>b66d4c3d-0411-4952-984c-f5a995b87849</UserSecretsId>
	  <ApplicationIcon>Assets\FusionHUD.ico</ApplicationIcon>
  </PropertyGroup>

	<ItemGroup>
	  <Content Include="Assets\FusionHUD.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FusionHUD.Performance\FusionHUD.Performance.csproj" />
		<ProjectReference Include="..\FusionHUD.Overlay\FusionHUD.Overlay.csproj" />
		<ProjectReference Include="..\FusionHUD.Monitoring\FusionHUD.Monitoring.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>